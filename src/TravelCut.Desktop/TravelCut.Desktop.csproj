<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TravelCut.Domain\TravelCut.Domain.csproj" />
    <ProjectReference Include="..\TravelCut.Application\TravelCut.Application.csproj" />
    <ProjectReference Include="..\TravelCut.Infrastructure\TravelCut.Infrastructure.csproj" />
    <ProjectReference Include="..\TravelCut.ResolveBridge\TravelCut.ResolveBridge.csproj" />
    <ProjectReference Include="..\TravelCut.Contracts\TravelCut.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\frontend\dist\**" Condition="Exists('..\..\frontend\dist\index.html')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>frontend\dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <!-- Workers Python (F05 / F08) -->
    <Content Include="..\..\workers\resolve_bridge.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>workers\resolve_bridge.py</Link>
    </Content>
    <Content Include="..\..\workers\whisper_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>workers\whisper_worker.py</Link>
    </Content>
  </ItemGroup>

</Project>

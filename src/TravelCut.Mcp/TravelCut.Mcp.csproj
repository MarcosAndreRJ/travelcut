<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TravelCut.Mcp</AssemblyName>
    <RootNamespace>TravelCut.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TravelCut.Domain\TravelCut.Domain.csproj" />
    <ProjectReference Include="..\TravelCut.Application\TravelCut.Application.csproj" />
    <ProjectReference Include="..\TravelCut.Infrastructure\TravelCut.Infrastructure.csproj" />
    <ProjectReference Include="..\TravelCut.Contracts\TravelCut.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDK oficial do Model Context Protocol para C# (stdio). -->
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Workers Python (F05 / F08) -->
    <Content Include="..\..\workers\resolve_bridge.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>workers\resolve_bridge.py</Link>
    </Content>
    <Content Include="..\..\workers\whisper_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>workers\whisper_worker.py</Link>
    </Content>
  </ItemGroup>

</Project>
